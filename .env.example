# Crea un archivo llamado .env.local (mismo folder que este archivo) con
# tus valores reales. Los obtienes en tu proyecto de Supabase:
# Project Settings -> API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la página (sin "/" al final). Se usa para canonical,
# la imagen al compartir en WhatsApp y el sitemap.
# En Vercel: Settings -> Environment Variables -> VITE_SITE_URL
   VITE_SITE_URL=https://charolas-locas.vercel.app
